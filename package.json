    "@yielded/auth-platform-workerd": "workspace:*",
    "@yielded/auth-simplewebauthn": "workspace:*",
    "@yielded/effect-tsrs": "catalog:",
    "@yielded/oauth": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
